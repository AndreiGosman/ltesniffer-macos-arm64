diff --git a/lib/src/prof/Stopwatch.cc b/lib/src/prof/Stopwatch.cc
index 93e1d9b..d9a88d7 100644
--- a/lib/src/prof/Stopwatch.cc
+++ b/lib/src/prof/Stopwatch.cc
@@ -47,7 +47,8 @@ timeval Stopwatch::getAndContinue() const {
 std::string Stopwatch::toString(timeval t) {
   const size_t buf_sz = 20;
   char strbuf[buf_sz] = {0};
-  snprintf(strbuf, buf_sz, "%ld.%06ld", t.tv_sec, t.tv_usec);
+  snprintf(strbuf, buf_sz, "%ld.%06ld",
+           static_cast<long>(t.tv_sec), static_cast<long>(t.tv_usec));
   strbuf[buf_sz-1] = 0; //prevent buffer overflows
   return std::string(strbuf);
 }
