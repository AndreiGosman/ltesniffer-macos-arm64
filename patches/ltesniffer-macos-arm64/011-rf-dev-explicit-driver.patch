From ba12a56c9fafb697615fa16ff922a2cab2e6b412 Mon Sep 17 00:00:00 2001
From: Andrei Gosman <andrei.gosman@gmail.com>
Date: Sun, 4 Oct 2026 08:53:08 +0300
Subject: [PATCH 11/11] args: add --rf-dev to open one named RF driver and no
 other

Without a driver name srsran_rf_open_multi runs the srsRAN auto mode, which
probes the drivers in order, UHD first, and keeps the first that opens. With
a USRP class radio connected that is the radio, whatever the device string
says, so a loopback run with ZeroMQ arguments ends up on real hardware, and
on a machine with several SDRs the first one found wins.

--rf-dev <driver> passes the name to srsran_rf_open_devname, which opens that
driver and returns its error without trying the next one. The option is long
only, so the short option string is unchanged; the parser moves from getopt
to getopt_long for it. Without the option the old behaviour stays.
---
 src/include/ArgManager.h   |  5 ++++-
 src/src/ArgManager.cc      | 20 +++++++++++++++++++-
 src/src/LTESniffer_Core.cc | 12 +++++++++++-
 3 files changed, 34 insertions(+), 3 deletions(-)

diff --git a/src/include/ArgManager.h b/src/include/ArgManager.h
index 6174b74..4cfd05c 100644
--- a/src/include/ArgManager.h
+++ b/src/include/ArgManager.h
@@ -45,7 +45,10 @@ struct Args {
   uint16_t    rnti;
   int         mcs_tracking_mode;
   int         verbose;
-  char*       rf_dev;
+  // RF driver to open, and only that one: "zmq", "uhd", ... as srsRAN names
+  // them. Empty means the srsRAN auto mode, which probes every driver in
+  // turn and opens the first that answers, a real radio included.
+  std::string rf_dev = "";
   //char* rf_args;
   int         enable_cfo_ref;
   std::string estimator_alg;
diff --git a/src/src/ArgManager.cc b/src/src/ArgManager.cc
index bded5b4..d3cbc13 100644
--- a/src/src/ArgManager.cc
+++ b/src/src/ArgManager.cc
@@ -5,6 +5,7 @@
 #include "include/Settings.h"
 #include <iostream>
 #include <unistd.h>
+#include <getopt.h>
 #include <cstdio>
 
 #define ENABLE_AGC_DEFAULT
@@ -102,13 +103,30 @@ void ArgManager::usage(Args& args, const std::string& prog) {
   printf("\t-m Sniffer mode, 0 for downlink sniffing mode, 1 for uplink sniffing mode\n");
   printf("\t-z API mode, 0 for identity mapping, 1 for IMSI collecting, 2 for UECapability profiling, 3 for all\n");
   printf("\t-d Enable debug mode, print debug message to screen (Defautl disable)\n");
+  printf("\t--rf-dev <driver> Open this RF driver and no other (zmq, uhd, soapy,\n");
+  printf("\t             bladeRF, file, as srsRAN names them). Without it every\n");
+  printf("\t             driver is probed in turn and the first that opens wins,\n");
+  printf("\t             which can be a real radio even with loopback arguments.\n");
 }
 
 void ArgManager::parseArgs(Args& args, int argc, char **argv) {
   int opt;
   defaultArgs(args);
-  while ((opt = getopt(argc, argv, "a:A:c:CD:dE:f:g:hH:i:l:Ln:p:P:r:R:sS:t:T:vwW:y:Y:q:F:I:u:Um:O:o:z:")) != -1) {
+
+  /* Long-only options start past the printable range so they cannot collide
+     with a short option letter. The short option string is unchanged. */
+  enum { OPT_RF_DEV = 1001 };
+  static struct option long_options[] = {
+      {"rf-dev", required_argument, nullptr, OPT_RF_DEV},
+      {nullptr, 0, nullptr, 0}};
+
+  while ((opt = getopt_long(argc, argv,
+                            "a:A:c:CD:dE:f:g:hH:i:l:Ln:p:P:r:R:sS:t:T:vwW:y:Y:q:F:I:u:Um:O:o:z:",
+                            long_options, nullptr)) != -1) {
     switch (opt) {
+      case OPT_RF_DEV:
+        args.rf_dev = optarg;
+        break;
       case 'a':
         args.rf_args = optarg;
         break;
diff --git a/src/src/LTESniffer_Core.cc b/src/src/LTESniffer_Core.cc
index 7018ab4..4c2e565 100644
--- a/src/src/LTESniffer_Core.cc
+++ b/src/src/LTESniffer_Core.cc
@@ -159,7 +159,17 @@ bool LTESniffer_Core::run(){
     printf("Opening RF device with %d RX antennas...\n", args.rf_nof_rx_ant);
     char rfArgsCStr[1024];
     strncpy(rfArgsCStr, args.rf_args.c_str(), 1024);
-    if (srsran_rf_open_multi(&rf, rfArgsCStr, args.rf_nof_rx_ant)) {
+    if (!args.rf_dev.empty()) {
+      /* One driver, named. srsran_rf_open_devname with a name opens that
+         driver and returns its error; it never falls through to the next
+         one. The auto mode below does, and would open a real radio ahead of
+         a loopback driver. */
+      printf("Opening RF driver '%s' only\n", args.rf_dev.c_str());
+      if (srsran_rf_open_devname(&rf, args.rf_dev.c_str(), rfArgsCStr, args.rf_nof_rx_ant)) {
+        fprintf(stderr, "Error opening RF driver '%s'\n", args.rf_dev.c_str());
+        exit(-1);
+      }
+    } else if (srsran_rf_open_multi(&rf, rfArgsCStr, args.rf_nof_rx_ant)) {
       fprintf(stderr, "Error opening rf\n");
       exit(-1);
     }
