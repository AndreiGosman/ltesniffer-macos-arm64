From 8f0ee717599b58be1eb14a597d48eaf221e2f24c Mon Sep 17 00:00:00 2001
From: Andrei Gosman <andrei.gosman@gmail.com>
Date: Fri, 2 Oct 2026 18:10:00 +0300
Subject: [PATCH 07/10] core: no thread affinity on Darwin

run() sets the main thread's CPU affinity with cpu_set_t, CPU_SET and
pthread_setaffinity_np, all Linux extensions absent on Darwin. Guard the block
with __linux__ so the affinity request is ignored on macOS rather than failing
to compile; Darwin cannot pin a thread to a core.
---
 src/src/LTESniffer_Core.cc | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/src/src/LTESniffer_Core.cc b/src/src/LTESniffer_Core.cc
index e091341..7018ab4 100644
--- a/src/src/LTESniffer_Core.cc
+++ b/src/src/LTESniffer_Core.cc
@@ -130,6 +130,7 @@ bool LTESniffer_Core::run(){
   int mcs_tracking_timer = 0;
   int update_rnti_timer = 0;
   /* Set CPU affinity*/
+#ifdef __linux__
   if (args.cpu_affinity > -1) {
     cpu_set_t cpuset;
     pthread_t thread;
@@ -146,6 +147,11 @@ bool LTESniffer_Core::run(){
       }
     }
   }
+#else
+  // Darwin has no cpu_set_t or pthread_setaffinity_np; thread affinity cannot be
+  // pinned. Ignore the request rather than fake it.
+  (void)args.cpu_affinity;
+#endif
 
   /* If RF mode (not file mode)*/
 #ifndef DISABLE_RF
