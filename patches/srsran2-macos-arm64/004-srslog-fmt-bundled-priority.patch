From 079766593e6f83bdcacbe3892acffe6de0d0c22f Mon Sep 17 00:00:00 2001
From: Andrei Gosman <andrei.gosman@gmail.com>
Date: Fri, 2 Oct 2026 15:00:00 +0300
Subject: [PATCH 04/13] srslog: give the bundled fmt priority over a system one

bundled/fmt/format.cc includes fmt headers that fall through to the -I list.
Homebrew's fmt on /opt/homebrew/include is otherwise reached first and supplies
a different major version than this tree's bundled sources expect, producing a
wall of errors naming basic_data, float_specs, dynamic_arg_list and FMT_SNPRINTF.
include_directories(BEFORE ...) puts the bundled directory first.
---
 lib/src/srslog/CMakeLists.txt | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/lib/src/srslog/CMakeLists.txt b/lib/src/srslog/CMakeLists.txt
index 635d064..2c565bf 100644
--- a/lib/src/srslog/CMakeLists.txt
+++ b/lib/src/srslog/CMakeLists.txt
@@ -24,7 +24,11 @@ set(SOURCES
     srslog_c.cpp
     event_trace.cpp)
 
-include_directories(${PROJECT_SOURCE_DIR}/lib/include/srsran/srslog/bundled/)
+# BEFORE matters. bundled/fmt/format.cc includes "fmt/format-inl.h", which does
+# not resolve next to the source file, so it falls through to the -I list. Any fmt
+# installed system wide, for example Homebrew's on macOS, is otherwise reached first
+# and supplies a different major version of the library than this tree expects.
+include_directories(BEFORE ${PROJECT_SOURCE_DIR}/lib/include/srsran/srslog/bundled/)
 include_directories(${PROJECT_SOURCE_DIR}/lib/include/srsran/srslog/formatters)
 
 set(SOURCES
