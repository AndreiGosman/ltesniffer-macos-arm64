From e9b01904413dbe06b065f175efdd32ecb4052119 Mon Sep 17 00:00:00 2001
From: Andrei Gosman <andrei.gosman@gmail.com>
Date: Fri, 2 Oct 2026 12:00:00 +0300
Subject: [PATCH 1/3] build: treat Darwin arm64 as aarch64 for NEON and arch
 flags

CMAKE_SYSTEM_PROCESSOR is arm64 on Darwin and aarch64 on Linux for the
same 64-bit ARM architecture. The tree guards GCC_ARCH armv8-a and
HAVE_NEONv8 on the exact string aarch64, and guards the 32-bit
-mfloat-abi/-mfpu options on the arm substring, which also matches arm64.
Without normalisation Apple Silicon gets the wrong arch flag, loses
NEONv8 and is offered 32-bit ARM options the compiler rejects.

Normalise arm64 to aarch64 once, right after project(), so every existing
aarch64 guard applies unchanged and no arm-substring guard misfires.
---
 CMakeLists.txt | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 26bf960..34ebd4e 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -34,6 +34,16 @@ cmake_minimum_required(VERSION 2.6)
 project( SRSRAN )
 message( STATUS "CMAKE_SYSTEM: " ${CMAKE_SYSTEM} )
 message( STATUS "CMAKE_SYSTEM_PROCESSOR: " ${CMAKE_SYSTEM_PROCESSOR} )
+
+# Darwin reports the 64-bit ARM processor as "arm64"; Linux reports "aarch64".
+# They are the same architecture with the same NEONv8 instruction set; only the
+# string differs. Normalise to aarch64 once, here, so the existing aarch64 guards
+# (GCC_ARCH armv8-a at the arch block, HAVE_NEONv8 at the compiler-flag block)
+# apply unchanged on Apple Silicon, and the 32-bit "arm" substring guards do not.
+if(CMAKE_SYSTEM_PROCESSOR STREQUAL "arm64")
+  set(CMAKE_SYSTEM_PROCESSOR "aarch64")
+  message(STATUS "Normalised CMAKE_SYSTEM_PROCESSOR arm64 -> aarch64")
+endif()
 message( STATUS "CMAKE_CXX_COMPILER: " ${CMAKE_CXX_COMPILER} )
 
 list(APPEND CMAKE_MODULE_PATH "${PROJECT_SOURCE_DIR}/cmake/modules")
-- 
