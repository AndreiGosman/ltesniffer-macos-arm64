From 3335b8ef72612dfff3ce59dd2229a236387aa8b6 Mon Sep 17 00:00:00 2001
From: Andrei Gosman <andrei.gosman@gmail.com>
Date: Fri, 2 Oct 2026 12:00:00 +0300
Subject: [PATCH 3/3] build: do not force -Werror on Apple clang

-Werror is added unconditionally for compilers newer than 5.0. Apple
clang is far newer than the gcc/clang this 2021 tree targets and raises
many new style warnings (unused-but-set-variable and similar) on
inherited code. These are not macOS portability defects and promoting
them to errors blocks the build. Real portability problems are hard
errors regardless. Exclude Apple from the -Werror addition.
---
 CMakeLists.txt | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 34ebd4e..d40a323 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -548,8 +548,14 @@ if("Ninja" STREQUAL ${CMAKE_GENERATOR})
   ADD_CXX_COMPILER_FLAG_IF_AVAILABLE("-fdiagnostics-color=always" HAVE_DIAGNOSTIC_COLOR_CXX)
 endif()
 
-# Add -Werror to C/C++ flags for newer compilers
-if(NOT CMAKE_CXX_COMPILER_VERSION VERSION_LESS 5.0)
+# Add -Werror to C/C++ flags for newer compilers.
+# Skip on Apple clang: this tree targets the gcc/clang of 2021, and the much
+# newer Apple clang raises many new -Wunused-but-set-variable and similar
+# diagnostics on inherited code. Those are upstream style warnings, not macOS
+# portability defects, so promoting them to errors blocks the port without
+# catching anything Darwin-specific. The real portability issues surface as
+# hard errors regardless of -Werror.
+if(NOT CMAKE_CXX_COMPILER_VERSION VERSION_LESS 5.0 AND NOT APPLE)
   set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -Werror")
   set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -Werror")
 endif()
