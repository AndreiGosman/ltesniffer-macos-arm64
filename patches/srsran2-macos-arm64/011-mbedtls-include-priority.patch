From ce4b4118cd93ab9461e876eee99e1d2c684bf7d9 Mon Sep 17 00:00:00 2001
From: Andrei Gosman <andrei.gosman@gmail.com>
Date: Fri, 2 Oct 2026 15:00:00 +0300
Subject: [PATCH 11/13] build: give the selected mbedtls priority over any
 other

SEC_INCLUDE_DIRS was added after the inherited include paths, so Homebrew's
mbedtls on /opt/homebrew/include supplied mbedtls/md.h while the chosen 2.28
library was linked. mbedtls 4 removed the one-shot mbedtls_md_hmac that
srsran/common/ssl.h uses, so the header and library disagreed and ssl.h failed.
include_directories(BEFORE ...) puts the chosen include directory first.
---
 CMakeLists.txt | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index d40a323..f420451 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -202,6 +202,13 @@ else(POLARSSL_FOUND)
   find_package(MbedTLS REQUIRED)
   if (MBEDTLS_FOUND)
     set(SEC_INCLUDE_DIRS "${MBEDTLS_INCLUDE_DIRS}")
+    # BEFORE matters when more than one mbedtls is installed. Consumers add
+    # SEC_INCLUDE_DIRS after the inherited include paths, so a newer mbedtls in
+    # a Homebrew prefix supplies the headers instead and mixes them with the
+    # selected library. mbedtls 4 removed the one-shot mbedtls_md_hmac that
+    # srsran/common/ssl.h needs, so the build fails unless the chosen include
+    # directory comes first.
+    include_directories(BEFORE ${MBEDTLS_INCLUDE_DIRS})
     if(BUILD_STATIC)
       set(SEC_LIBRARIES    "${MBEDTLS_STATIC_LIBRARIES}")
     else(BUILD_STATIC)
